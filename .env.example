# Non-production fixture default
TARGET_URL=http://127.0.0.1:3100
QA_ALLOWED_ORIGINS=http://127.0.0.1:3100

# Read only by the browser host immediately before a fill action.
QA_EMAIL=qa@example.test
QA_PASSWORD=replace-with-a-test-password

# Pinned model configuration. The default uses OpenRouter GLM 5.2.
QA_MODEL_PROVIDER=openrouter
QA_MODEL_ID=z-ai/glm-5.2
QA_MODEL_API_KEY=
